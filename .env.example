# Copy to .env (never commit .env). Every key is optional: the local model needs none.
# Generated from the names the code actually reads (pinned by tests/test_phase9.py).

# Market data (src/market/alpha_vantage.py; enabled on USER_ACCEPTED_RISK, END_OF_DAY only)
ALPHAVANTAGE_API_KEY=

# Crypto (src/market/coingecko.py; optional free Demo key -- works keyless at ~5 calls/min)
COINGECKO_DEMO_API_KEY=

# Company fundamentals from SEC EDGAR (src/rag/sec_facts.py): SEC requires a contact e-mail
# in the User-Agent. Not a secret, but personal, so it is read from the environment.
SEC_CONTACT_EMAIL=

# FRED macro data (src/rag/fred.py; free key from fredaccount.stlouisfed.org). Read from the
# environment only -- the project loads no .env file. Windows: setx FRED_API_KEY <key>
FRED_API_KEY=

# Optional remote LLM providers (src/llm/providers.py). The local model stays the default.
AGENTROUTER_API_KEY=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
CUSTOM_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
